# Local backend settings. Copy this file to .env; .env is git-ignored.
FLEXMAP_MASTER_INTERNAL_TOKEN=replace_with_the_same_internal_token_used_by_the_web_server

# Required when the CV engine publishes to a remote backend. Use the same long,
# random value in the backend and the local CV process.
FLEXMAP_ENGINE_TOKEN=replace_with_a_long_random_engine_token

# Authoritative persistence. Local keeps SQLite/files authoritative; supabase
# makes Postgres/private Storage authoritative for hosted collection data.
FLEXMAP_DATA_BACKEND=local

# Optional private Supabase Dataset Vault mirror in local mode. The mirror flag
# must remain false when FLEXMAP_DATA_BACKEND=supabase to prevent dual writers.
FLEXMAP_SUPABASE_URL=https://your-project-ref.supabase.co
FLEXMAP_SUPABASE_SECRET_KEY=sb_secret_replace_me
FLEXMAP_SUPABASE_SYNC_ENABLED=false
FLEXMAP_SUPABASE_VAULT_TABLE=flexmap_dataset_recordings
FLEXMAP_SUPABASE_VAULT_BUCKET=flexmap-dataset

# Metadata synchronization is lightweight and recommended first. Artifact upload
# includes videos and biosignal files; enable it only after confirming storage,
# retention, consent, and regional data-governance requirements.
FLEXMAP_SUPABASE_UPLOAD_ARTIFACTS=false
FLEXMAP_SUPABASE_TIMEOUT_SECONDS=20
