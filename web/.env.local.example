NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/posture
NEXT_PUBLIC_VIDEO_URL=http://localhost:8000/video-feed
NEXT_PUBLIC_USE_MOCK_POSTURE=false
NEXT_PUBLIC_STALE_AFTER_MS=2500

